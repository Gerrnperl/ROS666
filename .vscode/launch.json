                },
            ],
            "miDebuggerPath": "riscv64-unknown-elf-gdb", 
            "miDebuggerServerAddress": "localhost:25666",
            "preLaunchTask": "QEMU: launch qemu system (release)",
        },
        {
            "name": "调试用户程序",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/target/riscv64gc-unknown-none-elf/debug/${input:make.user-app}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
