    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试内核",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/target/riscv64gc-unknown-none-elf/debug/${input:make.kernel-elf}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set architecture to riscv:rv64",
                    "text": "set arch riscv:rv64",
                    "ignoreFailures": false
                },
            ],
            "miDebuggerPath": "riscv64-unknown-elf-gdb", 
            "miDebuggerServerAddress": "localhost:25666",
            "preLaunchTask": "QEMU: launch qemu system (dev)",
        },
        {
            "name": "运行内核",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/target/riscv64gc-unknown-none-elf/release/${input:make.kernel-elf}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
