{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        // #region 杂项
        {
            "type": "shell",
            "label": "Check: dev environment",
            "detail": "检查开发环境",
            "icon": {
                "id": "checklist",
                "color": "terminal.ansiRed"
            },
            "command": "make",
            "args": [
                "check-dev-requirements"
            ],
            "group": {
                "kind": "none",
                "isDefault": false
            },
            "problemMatcher": []
        },
        // #endregion 杂项
        // #region 构建
        {
            "type": "shell",
            "label": "Rust: build kernel (dev)",
            "detail": "构建内核 (开发模式)",
            "icon": {
                "id": "rocket",
                "color": "terminal.ansiMagenta"
            },
            "command": "make",
            "args": [
                "build-kernel.dev"
            ],
            "problemMatcher": [
                "$rustc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false,
            }
        },
        {
            "type": "shell",
            "label": "Rust: build kernel (release)",
            "detail": "构建内核 (发布模式)",
            "icon": {
                "id": "rocket",
                "color": "terminal.ansiBlue"
            },
            "command": "make",
            "args": [
                "build-kernel-release"
            ],
            "problemMatcher": [
                "$rustc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false,
            }
        },
        {
            "type": "shell",
            "label": "Rust: build user app (dev)",
            "detail": "构建用户程序 (开发模式)",
            "icon": {
                "id": "rocket",
                "color": "terminal.ansiMagenta"
            },
            "command": "make",
            "args": [
                "build-active-user.dev",
                "ACTIVE_USER_APP=${input:make.user-app}"
            ],
            "problemMatcher": [
                "$rustc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false,
            }
        },
        {
            "type": "shell",
            "label": "Rust: build user app (release)",
            "detail": "构建用户程序 (发布模式)",
            "icon": {
                "id": "rocket",
                "color": "terminal.ansiBlue"
            },
            "command": "make",
            "args": [
                "build-active-user.release",
                "ACTIVE_USER_APP=${input:make.user-app}"
            ],
            "problemMatcher": [
                "$rustc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false,
            }
        },
        // #endregion 构建
        // #region 运行
        {
            "type": "shell",
            "label": "QEMU: launch qemu system (dev)",
            "detail": "启动 QEMU 调试内核 (开发模式)",
            "icon": {
                "id": "vm-connect",
                "color": "terminal.ansiGreen"
            },
            "command": "make",
            "args": [
                "launch-qemu-system.dev",
            ],
            "group": {
                "kind": "none",
                "isDefault": true
            },
            "isBackground": true,
            "problemMatcher": [
                "$rustc",
                {
                    "pattern": [
                        {
                            "regexp": ".*?",
                            "file": 1,
                            "location": 2,
                            "message": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": {
                            "regexp": "QEMU launcher"
                        },
                        "endsPattern": {
                            "regexp": "QEMU launcher"
                        }
                    }
                }
            ]
        },
        {
            "type": "shell",
            "label": "QEMU: launch qemu system (release)",
            "detail": "启动 QEMU 运行内核 (发布模式)",
            "icon": {
                "id": "vm-connect",
                "color": "terminal.ansiYellow"
            },
            "command": "make",
            "args": [
                "launch-qemu-system.dev",
            ],
            "group": {
                "kind": "none",
                "isDefault": true
            },
            "isBackground": true,
            "problemMatcher": [
                "$rustc",
                {
                    "pattern": [
                        {
                            "regexp": ".*?",
                            "file": 1,
                            "location": 2,
                            "message": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": {
                            "regexp": "QEMU launcher"
                        },
                        "endsPattern": {
                            "regexp": "QEMU launcher"
                        }
                    }
                }
            ]
        },
        {
            "type": "shell",
            "label": "QEMU: launch qemu user (dev)",
            "detail": "启动 QEMU 调试用户程序 (开发模式)",
            "icon": {
                "id": "vm-connect",
                "color": "terminal.ansiGreen"
            },
            "command": "make",
            "args": [
                "launch-qemu-user.dev",
                "ACTIVE_USER_APP=${input:make.user-app}"
            ],
            "group": {
                "kind": "none",
                "isDefault": true
            },
            "isBackground": true,
            "problemMatcher": [
                "$rustc",
                {
                    "pattern": [
                        {
                            "regexp": ".*?",
                            "file": 1,
                            "location": 2,
                            "message": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": {
                            "regexp": "."
                        },
                        "endsPattern": {
                            "regexp": "."
                        }
                    }
                }
            ]
        },
        {
            "type": "shell",
            "label": "QEMU: launch qemu user (release)",
            "detail": "启动 QEMU 运行用户程序 (发布模式)",
            "icon": {
                "id": "vm-connect",
                "color": "terminal.ansiYellow"
            },
            "command": "make",
            "args": [
                "launch-qemu-user.release",
                "ACTIVE_USER_APP=${input:make.user-app}"
            ],
            "group": {
                "kind": "none",
                "isDefault": true
            },
            "isBackground": true,
            "problemMatcher": [
                "$rustc",
                {
                    "pattern": [
                        {
                            "regexp": ".*?",
                            "file": 1,
                            "location": 2,
                            "message": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": {
                            "regexp": "."
                        },
                        "endsPattern": {
                            "regexp": "."
                        }
                    }
                }
            ]
        },
        // #endregion 运行
    ],
    "inputs": [
        {
            "id": "make.kernel-elf",
            "type": "command",
            "command": "shellCommand.execute",
            "args": {
                "command": "make echo-make-args GET_MAKE_ARG=KERNEL_BINARY_NAME",
                "cwd": "${workspaceFolder}",
                "description": "选择要构建的内核",
                "useSingleResult": true
            }
        },
        {
            "id": "make.user-app",
            "type": "command",
            "command": "shellCommand.execute",
            "args": {
                "command": "make echo-make-args GET_MAKE_ARG=USER_APP_OPTION ACTIVE_USER_APP_PATH=${fileDirName} | tr ' ' '\\n'",
                "cwd": "${workspaceFolder}",
                "description": "选择要构建的用户程序",
                "useSingleResult": true
            }
        },
    ]
}